# Copy to .env.local for local emulator use.
# In production, set these via Firebase Secret Manager:
#   firebase functions:secrets:set SENDGRID_API_KEY

SENDGRID_API_KEY=SG....
SENDGRID_FROM_EMAIL=noreply@yourdomain.com
APP_URL=https://your-project.web.app
RECURRENTE_SECRET_KEY_TEST=sk_test_...
RECURRENTE_SECRET_KEY=sk_live_...
RECURRENTE_WEBHOOK_SECRET_TEST=whsec_test_...
RECURRENTE_WEBHOOK_SECRET=whsec_live_...
